#!/bin/bash
# pkgs-publish — manual: sign staged packages, rebuild the signed publish
# db from scratch, and rsync it to the server. This is the ONLY script
# that reads GPG_KEY; the timer path (pkgs-sync) never touches it.
#
# Usage: pkgs-publish [-n] [-h]
#   -n  dry-run: echo destructive commands instead of running them
#   -h  show this help
set -euo pipefail

PKGS_PROG=pkgs-publish
_lib=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/common.sh
# shellcheck source-path=SCRIPTDIR source=../lib/common.sh
. "$_lib"

usage() {
    cat <<'EOF'
usage: pkgs-publish [-n] [-h]

Sign staged packages, rebuild the signed publish repo from scratch, and
rsync it to the server. Blocks (waits) on the staging lock rather than
skipping, since this is a manual, interactive step.

  -n    dry-run: echo destructive commands (cp/rm/gpg/repo-add/rsync)
        instead of running them
  -h    show this help
EOF
}

# Captured before getopts shifts it, for the audit log's "Running" line.
PKGS_ARGV=("$@")

DRY_RUN=0
while getopts ':nh' opt; do
    case $opt in
        n) DRY_RUN=1 ;;
        h) usage; exit 0 ;;
        *) usage >&2; exit 1 ;;
    esac
done
shift $((OPTIND - 1))

# run CMD... — execute, or under -n just echo what would run.
run() {
    if ((DRY_RUN)); then
        printf '+ %s\n' "$*" >&2
    else
        "$@"
    fi
}

pkgs_load_conf
pkgs_require REPO_NAME STAGING_DIR PUBLISH_DIR GPG_KEY REMOTE
# The published repo carries its own name. pacman derives a repo's db
# filename from its pacman.conf section name, and the builder desktop has
# both repos declared, so they cannot share one: REPO_NAME is the
# staging/aurutils side, PUBLISH_NAME is what clients see. Nothing else in
# this script touches REPO_NAME — staging is read by filename, not by db.
# Defaulting keeps configs predating the split working.
: "${PUBLISH_NAME:=$REPO_NAME}"
pkgs_need_cmd gpg repo-add rsync cmp

[[ -d $STAGING_DIR ]] || die "staging dir does not exist: $STAGING_DIR"

# A dry run changes nothing, so it records nothing: leaving the log closed
# makes every pkgs_log below a no-op without a conditional at each call site,
# and keeps the -n path from depending on the log being writable.
((DRY_RUN)) || pkgs_log_open

# Interactive path: block until any concurrent timer sync releases the
# lock, rather than silently doing nothing (that's the -n behavior in
# pkgs-sync, not appropriate here).
pkgs_lock

pkgs_log_run "${PKGS_ARGV[@]}"
pkgs_log "transaction started"

[[ -d $PUBLISH_DIR ]] || run mkdir -p "$PUBLISH_DIR"

n_copied=0
n_signed=0
n_pruned=0

# Package extensions handled: zst is the norm, xz handled defensively.
shopt -s nullglob
staged_pkgs=("$STAGING_DIR"/*.pkg.tar.zst "$STAGING_DIR"/*.pkg.tar.xz)
shopt -u nullglob

# --- Step 1: copy new/changed packages, sign anything unsigned --------

declare -A staged_names=()
declare -A dirty=() # packages copied this run: sig is stale even if -n left it on disk
for src in "${staged_pkgs[@]}"; do
    name=${src##*/}
    staged_names[$name]=1
    dst="$PUBLISH_DIR/$name"

    if [[ ! -e $dst ]] || ! cmp -s "$src" "$dst"; then
        run cp -f "$src" "$dst"
        run rm -f "$dst.sig"
        dirty[$name]=1
        n_copied=$((n_copied + 1))
        pkgs_log "published $(pkgs_pkgid "$name")"
    fi
done

for src in "${staged_pkgs[@]}"; do
    name=${src##*/}
    dst="$PUBLISH_DIR/$name"
    sig="$dst.sig"
    [[ -e $sig && -z ${dirty[$name]+x} ]] && continue

    if ((DRY_RUN)); then
        run gpg --detach-sign -u "$GPG_KEY" --output "$sig" "$dst"
        n_signed=$((n_signed + 1))
        continue
    fi

    tmp="$sig.tmp.$$"
    if gpg --detach-sign -u "$GPG_KEY" --output "$tmp" "$dst"; then
        mv -f "$tmp" "$sig"
        n_signed=$((n_signed + 1))
        pkgs_log "signed $(pkgs_pkgid "$name")"
    else
        rm -f "$tmp"
        pkgs_fail "failed to sign $name"
    fi
done

# --- Step 2: prune packages/sigs no longer in staging ------------------

# Interrupting gpg above (Ctrl-C at the pinentry prompt, say) kills this
# script before its `rm -f "$tmp"` runs, leaving a zero-byte .sig.tmp.PID
# behind. The package/sig prune below never matches those, so without this
# they accumulate and get rsynced to the server forever.
shopt -s nullglob
for stale in "$PUBLISH_DIR"/*.sig.tmp.*; do
    run rm -f "$stale"
done
shopt -u nullglob

shopt -s nullglob
published_pkgs=("$PUBLISH_DIR"/*.pkg.tar.zst "$PUBLISH_DIR"/*.pkg.tar.xz)
shopt -u nullglob

for dst in "${published_pkgs[@]}"; do
    name=${dst##*/}
    if [[ -z ${staged_names[$name]+x} ]]; then
        run rm -f "$dst" "$dst.sig"
        n_pruned=$((n_pruned + 1))
        pkgs_log "unpublished $(pkgs_pkgid "$name")"
    fi
done

# Enforce the postcondition "every published package has a valid detached
# sig". repo-add -v does NOT do this: despite what the proposal says, -v
# verifies the signature of the *database* before updating it, and since we
# rebuild the db from scratch below there is no prior db sig to check. So
# check the package signatures here, before anything is shipped.
if ((!DRY_RUN)); then
    for src in "${staged_pkgs[@]}"; do
        name=${src##*/}
        dst="$PUBLISH_DIR/$name"
        if [[ ! -e $dst.sig ]]; then
            pkgs_fail "missing signature: $name"
        elif ! gpg --verify "$dst.sig" "$dst" >/dev/null 2>&1; then
            pkgs_fail "invalid signature: $name"
        fi
    done
fi

pkgs_fail_report || die "aborting before db rebuild due to signing failures above"

# Remove stale db/files artifacts before the rebuild — rebuild is always
# from scratch, never incremental.
run rm -f "$PUBLISH_DIR/$PUBLISH_NAME".db* "$PUBLISH_DIR/$PUBLISH_NAME".files*

# --- Step 3: rebuild the publish db from scratch ------------------------

shopt -s nullglob
publish_pkgs=("$PUBLISH_DIR"/*.pkg.tar.zst "$PUBLISH_DIR"/*.pkg.tar.xz)
shopt -u nullglob

if ((${#publish_pkgs[@]} > 0)); then
    if ! run repo-add -s -v -k "$GPG_KEY" "$PUBLISH_DIR/$PUBLISH_NAME.db.tar.gz" "${publish_pkgs[@]}"; then
        die "repo-add failed; aborting before rsync"
    fi
    pkgs_log "rebuilt ${#publish_pkgs[@]} package(s) into $PUBLISH_NAME.db.tar.gz"
else
    msg "no packages in $PUBLISH_DIR; skipping repo-add (empty repo)"
fi

# --- Step 4: rsync to the server (last, only after 1-3 succeed) --------

if ! run rsync -a --delete "$PUBLISH_DIR/" "$REMOTE/"; then
    die "rsync to $REMOTE failed"
fi
pkgs_log "rsynced to $REMOTE"

# The die paths above deliberately leave the transaction unterminated: an
# audit log block with no "transaction completed" is how a run that died
# announces itself.
pkgs_log "transaction completed ($n_copied published, $n_signed signed, $n_pruned unpublished)"

msg "done: $n_copied copied, $n_signed signed, $n_pruned pruned"
