#!/bin/bash
# pkgs-sync — timer entry point, run by the system timer as the dedicated
# build user. Refreshes the staging repo: AUR release packages first, then a
# VCS pass that rebuilds only those VCS packages whose upstream actually
# moved. Never touches gpg, GPG_KEY, PUBLISH_DIR, or REMOTE, and never adds
# or removes repo members.
#
# The VCS pass follows aurutils' shipped examples/sync-devel: the local
# repo's versions go to aur-vercmp on stdin, and the freshly computed
# versions from aur-srcver are supplied with -p. Membership comes from the
# repo database, so a package that is not already in the repo is never
# built here — refreshing is not adding.
set -euo pipefail

PKGS_PROG=pkgs-sync
_lib=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/common.sh
# shellcheck source-path=SCRIPTDIR source=../lib/common.sh
. "$_lib"

pkgs_load_conf
pkgs_require REPO_NAME STAGING_DIR CUSTOM_DIRS
# vercmp (pacman) only orders the two sides of a version change, to tell an
# upgrade from a downgrade in the audit log.
pkgs_need_cmd aur awk mktemp vercmp
# Opened before the lock so the skipped-run line can be written.
pkgs_log_open
pkgs_lock -n
pkgs_need_staging_write

pkgs_log_run "$@"
pkgs_log "transaction started"

# Where aurutils clones AUR build files (aur-sync(1): AURDEST).
AURDEST=${AURDEST:-${XDG_CACHE_HOME:-$HOME/.cache}/aurutils/sync}

# The AUR has no formal definition of a VCS package; this is the same set
# aurutils' own examples use.
VCS_RE='.*-(cvs|svn|git|hg|bzr|darcs)$'

tmp=$(mktemp -d) || die "cannot create temporary directory"
trap 'rm -rf "$tmp"' EXIT

# A mistyped CUSTOM_DIRS entry is worth reporting rather than ignoring: a
# locally maintained package whose directory cannot be found looks like a
# plain AUR package below, and would be silently fetched from the AUR.
for _d in "${CUSTOM_DIRS[@]}"; do
    [[ -d $_d ]] || pkgs_fail "CUSTOM_DIRS entry missing: $_d"
done

# snapshot_db ARRAY FILE — read the repo's "pkgname version" listing into the
# named associative array, via FILE. Non-zero if the listing failed.
snapshot_db() {
    local -n _snap=$1
    local file=$2 n v
    _snap=()
    aur repo -d "$REPO_NAME" --list >"$file" || return 1
    while read -r n v _; do
        [[ -n $n ]] || continue
        # $n is a string key, not an index: shellcheck cannot see through
        # the nameref that this is an associative array.
        # shellcheck disable=SC2004
        _snap[$n]=$v
    done <"$file"
    return 0
}

# What the audit log needs is the set of packages this run changed, and
# `aur sync -u` never reports what it built — pacman can log "upgraded foo
# (old -> new)" only because pacman is the thing performing the transaction,
# and here aurutils is. So diff the db's version listing across the run
# instead. Repo membership's source of truth is that db, and the staging lock
# is held from here to the end, so the difference is exactly this run's work.
declare -A before=()
have_before=1
if ! snapshot_db before "$tmp/before"; then
    pkgs_fail "aur repo -d $REPO_NAME --list failed (pre-run snapshot)"
    have_before=0
fi

## Pass 1 — AUR release packages, chroot builds.
if ! aur sync -u -c -d "$REPO_NAME" --no-view --noconfirm; then
    pkgs_fail "aur sync -u failed"
fi

## Pass 2 — VCS packages. Repo membership is the source of truth, so the
## candidate list comes from the database, not from the AUR or the disk.
if ! aur repo -d "$REPO_NAME" --list >"$tmp/db"; then
    pkgs_fail "aur repo -d $REPO_NAME --list failed"
    : >"$tmp/db"
fi
# Candidates are keyed by pkgbase, not pkgname: a split package contributes
# several pkgnames to the database but has exactly one build directory and
# one pkgver(). Filtering --list by name would make every non-base pkgname
# of a split VCS package ("foo-git-docs") look like a package whose PKGBUILD
# is missing, failing the run on every timer tick.
if ! aur repo -d "$REPO_NAME" --field base >"$tmp/bases"; then
    pkgs_fail "aur repo -d $REPO_NAME --field base failed"
    : >"$tmp/bases"
fi
awk -v mask="$VCS_RE" '$1 ~ mask {print $1}' "$tmp/bases" | sort -u >"$tmp/vcs"

# custom_dir PKGBASE — print the CUSTOM_DIRS subdirectory holding this
# pkgbase's PKGBUILD, if any. Being in a configured custom dir is the
# provenance: it marks the package as locally maintained rather than an
# AUR clone, so it is never fetched from the AUR.
custom_dir() {
    local pkgbase=$1 d
    for d in "${CUSTOM_DIRS[@]}"; do
        [[ -f $d/$pkgbase/PKGBUILD ]] && { printf '%s\n' "$d/$pkgbase"; return 0; }
    done
    return 1
}

# srcver_into FILE DIR — append "pkgbase\tversion" for DIR. aur-srcver
# resolves a pkgbase as a subdirectory of the working directory, so it has
# to run from the parent. This executes the PKGBUILD's pkgver() against the
# latest upstream checkout; it is the slow part of the run.
#
# pkgver() is chatty even when it works, so its stderr is held back and
# replayed only if srcver fails — a failure here is otherwise reported as a
# bare "aur srcver failed" with the reason discarded.
srcver_into() {
    local out=$1 dir=$2
    (cd "${dir%/*}" && pkgs_stderr_on_fail aur srcver "${dir##*/}") >>"$out"
}

declare -A pkgdir=()

if [[ -s $tmp/vcs ]]; then
    : >"$tmp/srcver"
    while read -r pkgbase; do
        [[ -n $pkgbase ]] || continue

        if dir=$(custom_dir "$pkgbase"); then
            :
        else
            # An AUR clone: refresh it so srcver sees new downstream commits.
            dir=$AURDEST/$pkgbase
            mkdir -p "$AURDEST"
            # Progress chatter on stdout stays discarded; git reports what
            # actually went wrong on stderr, so that is kept back and
            # replayed only on failure.
            if ! (cd "$AURDEST" && pkgs_stderr_on_fail aur fetch -S "$pkgbase") >/dev/null; then
                pkgs_fail "aur fetch failed: $pkgbase"
            fi
        fi

        if [[ ! -f $dir/PKGBUILD ]]; then
            pkgs_fail "no PKGBUILD directory found for $pkgbase"
            continue
        fi
        pkgdir[$pkgbase]=$dir

        if ! srcver_into "$tmp/srcver" "$dir"; then
            pkgs_fail "aur srcver failed: $pkgbase"
        fi
    done <"$tmp/vcs"

    # aur-vercmp reads the repo's versions on stdin and the candidate
    # versions from -p, printing "pkgname old -> new" for each package the
    # candidate file has newer. Anything else means no rebuild is needed.
    if [[ -s $tmp/srcver ]]; then
        aur vercmp -p "$tmp/srcver" <"$tmp/db" >"$tmp/cmp" || true
        awk '{print $1}' "$tmp/cmp" >"$tmp/ood"

        while read -r pkgbase; do
            [[ -n $pkgbase ]] || continue
            dir=${pkgdir[$pkgbase]-}
            if [[ -z $dir ]]; then
                pkgs_fail "no PKGBUILD directory found for $pkgbase"
                continue
            fi
            if ! (cd "$dir" && aur build -c -d "$REPO_NAME" --noconfirm); then
                pkgs_fail "build failed: $pkgbase"
            fi
        done <"$tmp/ood"
    fi
fi

# Note: custom (non-AUR) VCS packages need no separate pass. They appear in
# the repo listing above like any other member, and custom_dir() resolves
# them to their working directory instead of an AUR clone. A custom package
# that is not yet in the repo is deliberately not built: adding members is
# a manual step (aur build -c -d "$REPO_NAME"), never the timer's job.
# Non-VCS custom packages are never rebuilt automatically at all.

## Audit — diff the db against the pre-run snapshot and record what moved.

n_upgraded=0
n_downgraded=0
n_added=0
n_removed=0

if ((have_before)); then
    declare -A after=()
    if snapshot_db after "$tmp/after"; then
        # Sorted so a run's lines are in a stable order rather than the
        # associative array's hash order.
        while read -r name; do
            [[ -n $name ]] || continue
            new=${after[$name]}
            old=${before[$name]-}
            if [[ -z $old ]]; then
                pkgs_log "added $name ($new)"
                n_added=$((n_added + 1))
            elif [[ $old != "$new" ]]; then
                if (($(vercmp "$new" "$old") < 0)); then
                    pkgs_log "downgraded $name ($old -> $new)"
                    n_downgraded=$((n_downgraded + 1))
                else
                    pkgs_log "upgraded $name ($old -> $new)"
                    n_upgraded=$((n_upgraded + 1))
                fi
            fi
        done < <(printf '%s\n' "${!after[@]}" | sort)

        # Membership is never changed here — adding and removing members are
        # manual steps — so either direction is worth a line if it happens.
        while read -r name; do
            [[ -n $name ]] || continue
            [[ -n ${after[$name]+x} ]] && continue
            pkgs_log "removed $name (${before[$name]})"
            n_removed=$((n_removed + 1))
        done < <(printf '%s\n' "${!before[@]}" | sort)
    else
        pkgs_fail "aur repo -d $REPO_NAME --list failed (post-run snapshot)"
    fi
fi

pkgs_log "transaction completed ($n_upgraded upgraded, $n_downgraded downgraded, $n_added added, $n_removed removed, ${#PKGS_FAILURES[@]} failed)"

pkgs_fail_report
