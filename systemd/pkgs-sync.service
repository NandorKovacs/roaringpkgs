# System unit (systemctl, NOT --user): the sync runs as the dedicated build
# account, so the NOPASSWD sudoers rule the chroot helpers need belongs to
# that account and not to a human login.
#
# Assumes the build user pkgsbuild in group pkgs, this repo checked out at
# /opt/pkgs, and the shared config at /etc/pkgs/pkgs.conf — see the README.
# Any of the three can be overridden with `systemctl edit pkgs-sync.service`.
[Unit]
Description=Refresh staging repo (roaringpkgs)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=pkgsbuild
Group=pkgs
Environment=PKGS_CONF=/etc/pkgs/pkgs.conf
ExecStart=/opt/pkgs/bin/pkgs-sync

# Keep what the timer creates group-writable: the repos and the custom
# PKGBUILD dirs are shared with your own account through the pkgs group.
# Necessary but not sufficient, and deliberately kept anyway: repo-add and
# repo-remove set `umask 0022` internally and ignore this, as does `sudo
# makechrootpkg`. The default ACL on the shared dirs (README step 3) is what
# covers those.
UMask=0002

# No sandboxing knobs on purpose: NoNewPrivileges= would break the build
# outright (the chroot helpers are reached through setuid sudo), and the
# Protect*= family conflicts with systemd-nspawn's own mount setup. The
# isolation here is the unprivileged account plus the build chroot.
Nice=10
IOSchedulingClass=idle
